{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delywa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*", "/compartir/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delywa-db",
      "database_id": "91ee269f-6c1b-441e-b052-19fc3a038d1b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "UPLOADS", "bucket_name": "delywa-uploads" },
    // Respaldo diario de la base. Lo crea "npm run build" (scripts/preparar-cloudflare.mjs) si no existe.
    { "binding": "RESPALDOS", "bucket_name": "delywa-respaldos" }
  ],
  // Cola de avisos entrantes de WhatsApp. La crea "npm run build" (scripts/preparar-cloudflare.mjs) si no existe.
  "queues": {
    "producers": [{ "binding": "COLA_WEBHOOKS", "queue": "delywa-webhooks" }],
    "consumers": [{ "queue": "delywa-webhooks", "max_batch_size": 1, "max_batch_timeout": 1, "max_retries": 1 }]
  },
  // Tiempo real del panel: una sala (Durable Object con SQLite, incluido en el plan gratis) por sucursal.
  "durable_objects": { "bindings": [{ "name": "SALAS", "class_name": "SalaNegocio" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SalaNegocio"] }],
  // Workers AI: notas de voz (Whisper) y la IA de respaldo del bot del chat. Plan gratis: 10,000 neuronas al día.
  "ai": { "binding": "AI" },
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "PUBLIC_URL": "https://delywa.com" },
  "observability": { "enabled": true }
}
