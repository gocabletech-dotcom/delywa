{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delywa",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*", "/compartir/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delywa-db",
      "database_id": "91ee269f-6c1b-441e-b052-19fc3a038d1b",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "delywa-uploads" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "vars": { "PUBLIC_URL": "https://delywa.com" },
  "observability": { "enabled": true }
}
