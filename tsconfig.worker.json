{
  "include": ["worker/**/*", "shared/**/*"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"],
  "compilerOptions": {
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "strict": true,
    "lib": ["esnext"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": ["@cloudflare/workers-types"],
    "paths": { "@shared/*": ["./shared/*"] }
  }
}
